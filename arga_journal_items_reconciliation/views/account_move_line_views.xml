<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="reconciled_journal_items_action" model="ir.actions.act_window">
        <field name="name">Reconciled Journal Items</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot,graph,kanban</field>
        <field name="view_id" ref="account.view_move_line_tree"/>
        <field name="search_view_id" ref="account.view_account_move_line_filter"/>
        <field name="domain">[('display_type', 'not in', ('line_section', 'line_note')), ('full_reconcile_id', '!=', False)]</field>
        <field name="context">{'journal_type': 'general', 'search_default_posted': 1, 'create': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No fully reconciled journal items found</p>
            <p>Journal items appear here once they belong to a full reconciliation.</p>
        </field>
    </record>

    <record id="unreconciled_journal_items_action" model="ir.actions.act_window">
        <field name="name">Un-reconciled Journal Items</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot,graph,kanban</field>
        <field name="view_id" ref="account.view_move_line_tree"/>
        <field name="search_view_id" ref="account.view_account_move_line_filter"/>
        <field name="domain">[('display_type', 'not in', ('line_section', 'line_note')), ('full_reconcile_id', '=', False)]</field>
        <field name="context">{'journal_type': 'general', 'search_default_posted': 1, 'create': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No un-reconciled journal items found</p>
            <p>All journal items without a full reconciliation appear here, including accounts without Allow Reconciliation.
                Partial reconciliations are included, even when an individual item's residual is zero.</p>
        </field>
    </record>

    <menuitem id="reconciled_journal_items_menu" name="Reconciled Journal Items"
              parent="account.menu_finance_entries" action="reconciled_journal_items_action"
              groups="account.group_account_readonly" sequence="11"/>
    <menuitem id="unreconciled_journal_items_menu" name="Un-reconciled Journal Items"
              parent="account.menu_finance_entries" action="unreconciled_journal_items_action"
              groups="account.group_account_readonly" sequence="12"/>
</odoo>
